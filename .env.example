NEXORA_NAME=NEXORA
NEXORA_DB=data/nexora.db
NEXORA_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
NEXORA_OTP_SECRET=replace-with-a-different-random-secret-at-least-32-characters

NEXORA_SMTP_HOST=smtp.example.com
NEXORA_SMTP_PORT=587
NEXORA_SMTP_USERNAME=
NEXORA_SMTP_PASSWORD=
NEXORA_SMTP_FROM=noreply@example.com
NEXORA_SMTP_USE_SSL=false

NEXORA_TWILIO_ACCOUNT_SID=
NEXORA_TWILIO_AUTH_TOKEN=
NEXORA_TWILIO_FROM=

#optional local ollama server
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2